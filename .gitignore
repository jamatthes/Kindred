# Environment / secrets
.env
deploy/.env
# ...and any variant (.env.verify, .env.staging). The example is the one exception.
deploy/.env.*
!deploy/.env.example
# Vite's own convention for a developer's local overrides (e.g. VITE_GOOGLE_MAPS_BROWSER_KEY
# for `npm run dev` — see deploy/README.md's "Local development" section). Never committed.
web/.env.local
web/.env.*.local

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
*.egg-info/

# Node
node_modules/
dist/

# Playwright e2e harness (web/e2e) — reports, traces and screenshots from local runs.
web/e2e/report/
web/e2e/test-results/
# playwright.live.config.ts's own reporter/output dirs (smokes against the already-running
# deploy stack, not the isolated one above).
web/e2e/report-live/
web/e2e/test-results-live/

# Editor / OS
.vscode/
.idea/
Thumbs.db
.DS_Store

# Local data
*.local.json
pgdata/

# Container data — bind-mounted by deploy/docker-compose.yml (Postgres data directory and
# uploaded attachments). Never committed: it is large, machine-specific, and the database
# directory is meaningless outside the container that wrote it.
data/
web/test-results/
