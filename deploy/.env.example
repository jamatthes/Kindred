# Kindred — environment configuration
#
# Copy to deploy/.env and fill in. NEVER commit deploy/.env (it is in .gitignore).
# Every key below is read by server/app/core/config.py.
#
# Comments are on their own lines, never trailing a value. Docker Compose's env_file parser
# strips a trailing comment only when the value is non-empty: `KEY=            # note` yields
# the literal string "# note", not "". The blank Google and VAPID keys below MUST stay empty
# for the app to treat those integrations as unconfigured, so no value carries a trailing
# comment anywhere in this file.

# --- Database ---------------------------------------------------------------
# Postgres role
POSTGRES_USER=kindred
# Postgres password
POSTGRES_PASSWORD=change-me
# Database name
POSTGRES_DB=kindred
# API connection string. `postgres` is the compose service name.
# Host-side tools (alembic, pytest) need localhost instead; compose overrides this for the
# api container, so either form works here. See deploy/README.md.
DATABASE_URL=postgresql+asyncpg://kindred:change-me@postgres:5432/kindred

# --- Security ---------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
# The app refuses to boot while this is unset or still the placeholder below.
SECRET_KEY=generate-with-openssl-rand-hex-32
# Session cookie name
SESSION_COOKIE_NAME=kindred_session
# Session lifetime in hours (720 = 30 days)
SESSION_TTL_HOURS=720
# Failed logins per username and per IP before 429
RATE_LIMIT_LOGIN_PER_MINUTE=5

# --- First-run seed ---------------------------------------------------------
# Seeded platform admin
SEED_ADMIN_USERNAME=admin
# Seeded password; a change is forced on first login
SEED_ADMIN_PASSWORD=admin

# --- Networking -------------------------------------------------------------
# Used for invite links and push payloads
PUBLIC_BASE_URL=https://kindred.example.org
# Dev only; leave empty in production (same origin behind Caddy)
CORS_ORIGINS=http://localhost:5173
# The address Caddy serves on. Use a hostname in production and Caddy provisions TLS
# automatically; ":8080" serves plain HTTP for local testing. Several names may be listed,
# comma-separated ("kindred.example.org, www.kindred.example.org") — Caddy serves and
# certificates every one of them, so each must already resolve to this host or its ACME
# challenge fails.
KINDRED_SITE_ADDRESS=:8080
# The one name that is allowed to *serve* the app when several are listed above; every other
# name 301s here. One canonical origin is not a preference — the session cookie,
# PUBLIC_BASE_URL and invite links each name a single origin, so a login on `www` would not
# carry to the apex. Leave blank when KINDRED_SITE_ADDRESS is a single address.
#KINDRED_CANONICAL_HOST=kindred.example.org
# Host port published for Caddy
KINDRED_HTTP_PORT=8080

# --- Google Maps Platform ---------------------------------------------------
# TWO SEPARATE KEYS ARE MANDATORY (see plan/architecture.md guardrails):
#   browser key -> restricted by HTTP referrer;  server key -> restricted by IP.
# Both may be left blank: the app starts and runs, degrading only the features that need them.
# Maps JS + Places (browser SDK). Baked into the web image at BUILD time (Vite inlines
# import.meta.env.VITE_* when it runs, not at container start) -- deploy/docker-compose.yml
# passes this through as a build arg. Changing this value needs
# `docker compose -f docker-compose.yml up -d --build`, not just `up -d`: a plain restart
# keeps serving the previously-baked bundle with the old (or no) key.
GOOGLE_MAPS_BROWSER_KEY=
# Geocoding, Distance Matrix, Directions (server-side). Read at container start, same as
# every other server env var -- a plain restart (no rebuild) picks up a change here.
GOOGLE_MAPS_SERVER_KEY=
# How this deployment identifies itself to OpenStreetMap's Nominatim when fetching a named
# locality's boundary. Leave blank and one is built from PUBLIC_BASE_URL, which is what you
# want. Set it only to identify differently -- and never to a placeholder contact: Nominatim
# answers those with 403, and because a failed lookup is indistinguishable from "no boundary
# exists", every region search silently comes back empty.
NOMINATIM_USER_AGENT=

# --- OpenStreetMap (region boundaries) --------------------------------------
# Nominatim's usage policy requires a User-Agent identifying a *real* service; it answers a
# placeholder contact with 403, which turns every named-locality region lookup into a silent
# "no boundary found". Leave this blank and the app builds one from PUBLIC_BASE_URL above,
# which is what any normal deployment wants. Set it only to identify differently — a shared
# instance, or a contact address.
#NOMINATIM_USER_AGENT=

# --- Map suggestions --------------------------------------------------------
# Product judgements about geography, not secrets. Listed so they are tunable without a code
# change and findable without reading the service layer; the defaults are what ships.
# How near an activity or meal must be to an accommodation to be shown inside its card
# rather than as a separate entry — "the same building or its car park".
#SUGGESTION_GROUP_RADIUS_M=150
# How far a pin must move before the Distance Matrix is asked again. Below this the move is
# jitter, and re-querying would spend the API budget on a pin that did not really move.
#SUGGESTION_MOVE_EPSILON_M=25
# The radius of the region seeded from a decided poll option — a first sketch of "somewhere
# around here", meant to be redrawn.
#REGION_SEED_RADIUS_M=15000

# --- Web Push (pwa-push) ----------------------------------------------------
# Web Push public key
VAPID_PUBLIC_KEY=
# Web Push private key
VAPID_PRIVATE_KEY=
# Web Push contact
VAPID_SUBJECT=mailto:admin@example.org

# --- Misc -------------------------------------------------------------------
# Local volume for uploads
ATTACHMENTS_DIR=/data/attachments
# Container timezone
TZ=Europe/London
# API log level
LOG_LEVEL=info
