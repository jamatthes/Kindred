# Kindred — environment configuration
#
# Copy to deploy/.env and fill in. NEVER commit deploy/.env (it is in .gitignore).
# Every key below is read by server/app/core/config.py.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=kindred                     # Postgres role
POSTGRES_PASSWORD=change-me               # Postgres password
POSTGRES_DB=kindred                       # Database name
# API connection string. Host is the compose service name; use localhost for dev.
DATABASE_URL=postgresql+asyncpg://kindred:change-me@postgres:5432/kindred

# --- Security ---------------------------------------------------------------
# REQUIRED. Generate with: openssl rand -hex 32
# The app refuses to boot while this is unset or still the placeholder below.
SECRET_KEY=generate-with-openssl-rand-hex-32
SESSION_COOKIE_NAME=kindred_session       # Session cookie name
SESSION_TTL_HOURS=720                     # Session lifetime (30 days)
RATE_LIMIT_LOGIN_PER_MINUTE=5             # Failed logins per username and per IP before 429

# --- First-run seed ---------------------------------------------------------
SEED_ADMIN_USERNAME=admin                 # Seeded platform admin
SEED_ADMIN_PASSWORD=admin                 # Seeded password; forced change on first login

# --- Networking -------------------------------------------------------------
PUBLIC_BASE_URL=https://kindred.example.org   # Used for invite links and push payloads
CORS_ORIGINS=http://localhost:5173            # Dev only; empty in production (same origin)

# --- Google Maps Platform ---------------------------------------------------
# TWO SEPARATE KEYS ARE MANDATORY (see plan/architecture.md guardrails):
#   browser key -> restricted by HTTP referrer;  server key -> restricted by IP.
# Both may be blank: the app starts and runs, degrading only the features that need them.
GOOGLE_MAPS_BROWSER_KEY=                  # Maps JS + Places (browser SDK)
GOOGLE_MAPS_SERVER_KEY=                   # Geocoding, Distance Matrix, Directions (server-side)

# --- Web Push (pwa-push) ----------------------------------------------------
VAPID_PUBLIC_KEY=                         # Web Push public key
VAPID_PRIVATE_KEY=                        # Web Push private key
VAPID_SUBJECT=mailto:admin@example.org    # Web Push contact

# --- Misc -------------------------------------------------------------------
ATTACHMENTS_DIR=/data/attachments         # Local volume for uploads
TZ=Europe/London                          # Container timezone
LOG_LEVEL=info                            # API log level
